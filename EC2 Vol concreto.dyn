    {
      "ConcreteType": "DSRevitNodesUI.ElementsOfCategory, DSRevitNodesUI",
      "Id": "47bfc1c62b6d49ce9b61f3eee9f11542",
      "NodeType": "ExtensionNode",
      "Inputs": [
        {
          "Id": "278bb8f5bc00448ea864a5cf401c48ad",
          "Name": "Category",
          "Description": "The Category",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "0852d2023fcf4e1e8e4ac4de364fdcea",
          "Name": "Elements",
          "Description": "An element class.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Get all elements of the specified category from the model."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# =========================================================\r\n# REFERENCIAS\r\n# =========================================================\r\n\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\n\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n\r\n# =========================================================\r\n# DOCUMENTO ACTUAL\r\n# =========================================================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# =========================================================\r\n# ENTRADA DE DYNAMO\r\n# =========================================================\r\n\r\nentrada = IN[0]\r\n\r\nif not isinstance(entrada, list):\r\n    entrada = [entrada]\r\n\r\n\r\n# =========================================================\r\n# FUNCIÓN PARA APLANAR LISTAS\r\n# =========================================================\r\n\r\ndef aplanar(lista):\r\n\r\n    resultado = []\r\n\r\n    for elemento in lista:\r\n\r\n        if isinstance(elemento, list):\r\n            resultado.extend(aplanar(elemento))\r\n\r\n        else:\r\n            resultado.append(elemento)\r\n\r\n    return resultado\r\n\r\n\r\nentrada = aplanar(entrada)\r\n\r\n\r\n# =========================================================\r\n# CONVERTIR ELEMENTOS DE DYNAMO A REVIT\r\n# =========================================================\r\n\r\nelementos = []\r\n\r\nfor e in entrada:\r\n\r\n    elemento = UnwrapElement(e)\r\n\r\n    if elemento is not None:\r\n        elementos.append(elemento)\r\n\r\n\r\n# =========================================================\r\n# IDs DE CATEGORÍAS\r\n# =========================================================\r\n\r\nID_COLUMNAS = ElementId(\r\n    BuiltInCategory.OST_StructuralColumns\r\n).Value\r\n\r\nID_VIGAS = ElementId(\r\n    BuiltInCategory.OST_StructuralFraming\r\n).Value\r\n\r\nID_PISOS = ElementId(\r\n    BuiltInCategory.OST_Floors\r\n).Value\r\n\r\n\r\n# =========================================================\r\n# FUNCIÓN PARA OBTENER EL NIVEL\r\n# =========================================================\r\n\r\ndef obtener_nivel(el):\r\n\r\n    if el.Category is None:\r\n        return \"\"\r\n\r\n\r\n    categoria_id = el.Category.Id.Value\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # COLUMNAS\r\n    # -----------------------------------------------------\r\n\r\n    if categoria_id == ID_COLUMNAS:\r\n\r\n        parametro = el.get_Parameter(\r\n            BuiltInParameter.FAMILY_LEVEL_PARAM\r\n        )\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # VIGAS\r\n    # -----------------------------------------------------\r\n\r\n    elif categoria_id == ID_VIGAS:\r\n\r\n        parametro = el.get_Parameter(\r\n            BuiltInParameter.INSTANCE_REFERENCE_LEVEL_PARAM\r\n        )\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # PISOS / LOSAS\r\n    # -----------------------------------------------------\r\n\r\n    elif categoria_id == ID_PISOS:\r\n\r\n        parametro = el.get_Parameter(\r\n            BuiltInParameter.LEVEL_PARAM\r\n        )\r\n\r\n\r\n    else:\r\n\r\n        parametro = None\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # OBTENER NOMBRE DEL NIVEL\r\n    # -----------------------------------------------------\r\n\r\n    if parametro:\r\n\r\n        nivel_id = parametro.AsElementId()\r\n\r\n        if nivel_id != ElementId.InvalidElementId:\r\n\r\n            nivel = doc.GetElement(nivel_id)\r\n\r\n            if nivel:\r\n                return nivel.Name\r\n\r\n\r\n    return \"\"\r\n\r\n\r\n# =========================================================\r\n# FUNCIÓN PARA OBTENER VOLUMEN\r\n# =========================================================\r\n\r\ndef obtener_volumen(el):\r\n\r\n    parametro = el.get_Parameter(\r\n        BuiltInParameter.HOST_VOLUME_COMPUTED\r\n    )\r\n\r\n\r\n    if parametro:\r\n\r\n        volumen_ft3 = parametro.AsDouble()\r\n\r\n\r\n        # Conversión de pies cúbicos a metros cúbicos\r\n\r\n        volumen_m3 = volumen_ft3 * 0.028316846592\r\n\r\n\r\n        return round(volumen_m3, 3)\r\n\r\n\r\n    return 0\r\n\r\n\r\n# =========================================================\r\n# CREAR TABLA\r\n# =========================================================\r\n\r\ntabla = []\r\n\r\n\r\n# =========================================================\r\n# ENCABEZADOS\r\n# =========================================================\r\n\r\ntabla.append([\r\n\r\n    \"Categoría\",\r\n    \"Tipo\",\r\n    \"Nivel\",\r\n    \"Id\",\r\n    \"Volumen (m3)\"\r\n\r\n])\r\n\r\n\r\n# =========================================================\r\n# RECORRER ELEMENTOS\r\n# =========================================================\r\n\r\nfor el in elementos:\r\n\r\n    if el is None:\r\n        continue\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # COMPROBAR CATEGORÍA\r\n    # -----------------------------------------------------\r\n\r\n    if el.Category is None:\r\n        continue\r\n\r\n\r\n    categoria_id = el.Category.Id.Value\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # SOLO COLUMNAS, VIGAS Y PISOS\r\n    # -----------------------------------------------------\r\n\r\n    if categoria_id not in [\r\n\r\n        ID_COLUMNAS,\r\n        ID_VIGAS,\r\n        ID_PISOS\r\n\r\n    ]:\r\n\r\n        continue\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # CATEGORÍA\r\n    # -----------------------------------------------------\r\n\r\n    categoria = el.Category.Name\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # TIPO\r\n    # -----------------------------------------------------\r\n\r\n    tipo = doc.GetElement(\r\n        el.GetTypeId()\r\n    )\r\n\r\n\r\n    nombre_tipo = \"\"\r\n\r\n\r\n    if tipo:\r\n\r\n        parametro_nombre = tipo.get_Parameter(\r\n            BuiltInParameter.SYMBOL_NAME_PARAM\r\n        )\r\n\r\n\r\n        if parametro_nombre:\r\n\r\n            nombre_tipo = parametro_nombre.AsString()\r\n\r\n\r\n        else:\r\n\r\n            nombre_tipo = tipo.Name\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # NIVEL\r\n    # -----------------------------------------------------\r\n\r\n    nivel = obtener_nivel(el)\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # ID\r\n    # -----------------------------------------------------\r\n\r\n    id_elemento = el.Id.Value\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # VOLUMEN\r\n    # -----------------------------------------------------\r\n\r\n    volumen = obtener_volumen(el)\r\n\r\n\r\n    # -----------------------------------------------------\r\n    # AGREGAR FILA\r\n    # -----------------------------------------------------\r\n\r\n    tabla.append([\r\n\r\n        categoria,\r\n\r\n        nombre_tipo,\r\n\r\n        nivel,\r\n\r\n        id_elemento,\r\n\r\n        volumen\r\n\r\n    ])\r\n\r\n\r\n# =========================================================\r\n# SALIDA\r\n# =========================================================\r\n\r\nOUT = tabla",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "5c62459045504b79b7a97cc1cb851884",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "b21d27723e5b4a309683ead6667231ad",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "266fe6bf6c664a0895364490659bd847",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
